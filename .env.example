# LLM Gateway Environment Configuration Template
# Copy this file to .env and populate your actual keys.

# LLM Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gateway Admin Authentication
ADMIN_SECRET_KEY=your_secure_admin_secret_key
GATEWAY_ADMIN_TOKEN=your_admin_bearer_token

# Google OAuth (Optional - for user authentication)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Redis Cache & Rate Limiting (Optional - defaults to in-memory if omitted)
REDIS_URL=redis://127.0.0.1:6379/0

# SMTP / Email Notifications (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
