{
  "guardrails": {
    "enabled": true,
    "block_on_pii": false,
    "max_payload_bytes": 1048576,
    "max_tokens": 32000,
    "system_prompts": [
      "You are a helpful AI assistant in a production LLM gateway.",
      "Internal system directive: confidential routing instructions."
    ]
  },
  "rate_limiting": {
    "enabled": true,
    "redis_url": "redis://127.0.0.1:6379/0",
    "redis_fail_closed": false,
    "default_quota_rpm": 60,
    "burst_capacity": 60
  },
  "cost_control": {
    "cache_enabled": true,
    "cache_ttl_sec": 3600,
    "coalescing_enabled": true,
    "default_daily_budget_usd": 5.0
  },
  "concurrency": {
    "global_max_inflight": 50,
    "providers": {
      "groq": {
        "max_inflight": 10,
        "max_queue_size": 20,
        "max_queue_wait_sec": 5.0
      },
      "openrouter": {
        "max_inflight": 10,
        "max_queue_size": 20,
        "max_queue_wait_sec": 5.0
      },
      "gemini": {
        "max_inflight": 10,
        "max_queue_size": 20,
        "max_queue_wait_sec": 5.0
      },
      "mock": {
        "max_inflight": 10,
        "max_queue_size": 20,
        "max_queue_wait_sec": 5.0
      },
      "mock2": {
        "max_inflight": 20,
        "max_queue_size": 40,
        "max_queue_wait_sec": 5.0
      }
    }
  },
  "mock": {
    "provider": "mock",
    "model": "mock-500ms",
    "fallback": [],
    "input_price_per_token": 0.00000005,
    "output_price_per_token": 0.00000008,
    "context_limit": 131072
  },
  "mock_failover": {
    "provider": "mock",
    "model": "mock-primary",
    "fallback": [
      {
        "provider": "mock2",
        "model": "mock-fallback"
      }
    ],
    "input_price_per_token": 0.00000005,
    "output_price_per_token": 0.00000008,
    "context_limit": 131072
  },
  "fast": {
