# LLM Gateway Environment Configuration Template
# Copy this file to .env and populate your actual keys.

# LLM Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gateway Admin Authentication (required: the app refuses to start without it)
GATEWAY_ADMIN_TOKEN=your_secure_admin_token

# Google OAuth (Optional - for user authentication)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Redis Cache & Rate Limiting (Optional - defaults to in-memory if omitted)
REDIS_URL=redis://127.0.0.1:6379/0

# Number of reverse proxies in front of the gateway. 0 = ignore X-Forwarded-For.
# Start uvicorn with --no-proxy-headers so this setting is authoritative.
TRUSTED_PROXY_COUNT=0

# Set only for non-CLI launchers that already disabled uvicorn proxy headers.
# GATEWAY_PROXY_HEADERS_DISABLED=1

# Redis-outage policy: open = allow requests, closed = reject with 429.
# Unset to use models.json rate_limiting.redis_fail_closed.
RATE_LIMIT_FAIL_MODE=closed

# Async job lease and heartbeat (seconds). Defaults: 15 / 5.
# GATEWAY_JOB_LEASE_SECONDS=15
# GATEWAY_JOB_HEARTBEAT_SECONDS=5

# Optional Fernet key used to encrypt stored Google OAuth tokens.
# When unset, a key is derived from GATEWAY_ADMIN_TOKEN; rotating the admin
# token then invalidates stored OAuth tokens (users must reconnect Google).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GATEWAY_OAUTH_ENCRYPTION_KEY=

# SMTP / Email Notifications (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
