FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ENV=development

WORKDIR /app

COPY requirements-dev.txt .
RUN python -m pip install --no-cache-dir -r requirements-dev.txt

COPY app ./app
COPY tests ./tests
COPY models.json .

CMD ["python", "-m", "pytest", "tests/test_multi_instance_reliability.py", "-q", "-s", "--tb=short"]
